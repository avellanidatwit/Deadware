# Copy to .env on the server only; fill blanks before starting.
NODE_ENV=production
PORT=3000
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=deadware
DATABASE_USER=deadware_app
DATABASE_PASSWORD=
SESSION_SECRET=
# Recommended: custom Pages domain and API subdomain under the same site.
CLIENT_ORIGIN=https://play.example.com
PUBLIC_API_ORIGIN=https://api.example.com
COOKIE_SAME_SITE=lax
# With a default github.io Pages origin, use SameSite=none; cookie blocking may still affect login.
SIMULATION_TICK_MS=100
DECISION_TICKS=6
CLIENT_POLL_MS=250
CHECKPOINT_MS=30000
