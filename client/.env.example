# Public values embedded into the built client. Never put passwords or secrets here.
# Empty uses the local Vite /api proxy. For Pages, set this as an Actions repository variable.
# Use the HTTPS API origin, without /api, another path, or a trailing slash.
VITE_API_URL=
# Local default. The Pages workflow detects /Deadware/ or / for your configured site.
# Optional Actions variable override: /Deadware/ for this repository, / for a custom domain.
VITE_BASE_PATH=./
