{
  "name": "deadware",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p client/tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "start": "npm run build && node --env-file=.env dist/server/src/main.js",
    "start:legacy": "npm run build && node server.mjs",
    "dev:client": "vite client",
    "build:client": "tsc -p client/tsconfig.json && vite build client",
    "build:legacy-client": "npm run build && node server/build-client.mjs",
    "db:migrate": "npm run build && node --env-file=.env dist/server/src/database/migrate.js"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
